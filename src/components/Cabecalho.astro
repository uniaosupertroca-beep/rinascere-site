---
// Abertura escura das páginas internas: o mesmo clima da home (aurora de bronze e palavra gigante
// em traço), com o ícone do procedimento num emblema à direita.
import type { NomeIcone } from "../data/icones.ts";
import Icone from "./Icone.astro";
import Monograma from "./Monograma.astro";

interface Props {
  id: string;
  chapeu: string;
  /** Link antes do chapéu, como uma trilha ("Procedimentos · Rosto"). */
  trilha?: { href: string; texto: string };
  titulo: string;
  destaque: string;
  resumo: string;
  /** Sem ícone, o emblema mostra o monograma da clínica. */
  icone?: NomeIcone;
  /** Palavra gigante, em traço, no fundo. */
  palavra: string;
}
const { id, chapeu, trilha, titulo, destaque, resumo, icone, palavra } = Astro.props;

const selos: { icone: NomeIcone; texto: string }[] = [
  { icone: "avaliacao", texto: "Avaliação individual" },
  { icone: "escudo", texto: "Termo de consentimento" },
  { icone: "cadeado", texto: "Atendimento reservado" },
];
---

<section class="cabecalho escura" aria-labelledby={id}>
  <div class="aurora" aria-hidden="true"></div>
  <span class="palavra" aria-hidden="true">{palavra}</span>
  <div class="envolve grade">
    <div class="emblema" aria-hidden="true">
      <span class="orbita"></span>
      <span class="nucleo">
        {icone ? <Icone nome={icone} tamanho={76} traco={1.05} /> : <Monograma tamanho={64} />}
      </span>
    </div>
    <div class="texto">
      <p class="chapeu">
        {
          trilha && (
            <>
              <a href={trilha.href}>{trilha.texto}</a>
              <span aria-hidden="true">·</span>
            </>
          )
        }
        {chapeu}
      </p>
      <h1 class="titulo" id={id}>{titulo} <strong>{destaque}</strong></h1>
      <p class="abre">{resumo}</p>
      <div class="acoes"><slot /></div>
      <ul class="selos">
        {
          selos.map((s) => (
            <li>
              <Icone nome={s.icone} tamanho={18} />
              {s.texto}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .cabecalho {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--grafite);
    color: var(--claro);
    padding: clamp(128px, 15vw, 184px) 0 clamp(104px, 15vw, 196px);
  }
  .aurora {
    position: absolute;
    inset: -20% -10% 0;
    z-index: -2;
    background:
      radial-gradient(42% 56% at 80% 40%, color-mix(in oklab, var(--bronze) 26%, transparent), transparent 70%),
      radial-gradient(40% 46% at 8% 92%, color-mix(in oklab, var(--bronze) 12%, transparent), transparent 70%),
      radial-gradient(60% 60% at 50% 0%, var(--grafite-3), transparent 75%);
    filter: blur(8px);
  }
  .palavra {
    position: absolute;
    right: -0.04em;
    bottom: -0.34em;
    z-index: -1;
    font-size: clamp(120px, 19vw, 300px);
    font-weight: 200;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--bronze) 20%, transparent);
    pointer-events: none;
    user-select: none;
  }

  .grade {
    display: grid;
    gap: 28px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .grade {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 72px;
    }
    .emblema {
      order: 2;
    }
  }

  .chapeu {
    gap: 10px;
    flex-wrap: wrap;
  }
  .chapeu a {
    color: inherit;
    text-underline-offset: 4px;
  }
  .titulo {
    font-size: clamp(38px, 6vw, 72px);
    font-weight: 200;
  }
  .acoes {
    margin-top: 32px;
  }

  .selos {
    list-style: none;
    padding: 24px 0 0;
    margin-top: 36px;
    border-top: 1px solid color-mix(in oklab, var(--claro) 12%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    font-size: 14.5px;
    color: var(--claro-2);
  }
  .selos li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .selos :global(svg) {
    flex: none;
    color: var(--bronze);
  }

  /* Emblema: anel fino, órbita tracejada com um ponto de luz e o ícone no centro. */
  .emblema {
    position: relative;
    width: clamp(132px, 26vw, 320px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .emblema::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--bronze) 20%, transparent);
    background: radial-gradient(closest-side, color-mix(in oklab, var(--bronze) 14%, transparent), transparent);
  }
  .orbita {
    position: absolute;
    inset: 11%;
    border-radius: 50%;
    border: 1px dashed color-mix(in oklab, var(--bronze) 45%, transparent);
  }
  .orbita::after {
    content: "";
    position: absolute;
    top: 14.6%;
    left: 14.6%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--bronze-claro);
    box-shadow: 0 0 14px 2px var(--bronze);
  }
  .nucleo {
    position: relative;
    width: 54%;
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--bronze);
    background: radial-gradient(circle at 35% 28%, var(--grafite-3), var(--grafite-2) 62%);
    border: 1px solid color-mix(in oklab, var(--bronze) 55%, transparent);
    box-shadow:
      0 0 80px -12px color-mix(in oklab, var(--bronze) 45%, transparent),
      inset 0 1px 0 color-mix(in oklab, var(--claro) 8%, transparent);
  }
  .nucleo :global(svg) {
    width: 56%;
    height: auto;
  }
  @media (max-width: 959px) {
    .emblema {
      justify-self: start;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .orbita {
      animation: gira 48s linear infinite;
    }
    .texto {
      animation: surge 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) both;
    }
    .emblema {
      animation: acende 1.4s 0.15s ease-out both;
    }
  }
  @keyframes gira {
    to {
      rotate: 1turn;
    }
  }
  @keyframes surge {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
  @keyframes acende {
    from {
      opacity: 0;
      scale: 0.92;
    }
  }
</style>
