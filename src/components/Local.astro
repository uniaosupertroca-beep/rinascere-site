---
// Sem mapa embutido: os botões abrem a rota no Google Maps ou no Waze (página mais leve e sem rastreio).
import { clinica, linkRotaGoogle, linkRotaWaze } from "../data/clinica.ts";
import Icone from "./Icone.astro";

const redes = [
  { href: clinica.redes.instagram, nome: "Instagram", icone: "instagram", detalhe: "@clinica.rinascere" },
  { href: clinica.redes.facebook, nome: "Facebook", icone: "facebook", detalhe: "Rinascere Clínica de Estética" },
  { href: clinica.redes.youtube, nome: "YouTube", icone: "youtube", detalhe: "Vídeos sobre o procedimento" },
] as const;
---

<section class="secao branca" id="onde-estamos" aria-labelledby="t-local">
  <div class="envolve">
    <p class="chapeu">Onde estamos</p>
    <h2 class="titulo" id="t-local">No centro <strong>de {clinica.cidade}.</strong></h2>
    <div class="grade">
      <div class="cartao endereco">
        <span class="icone"><Icone nome="local" /></span>
        <h3>{clinica.nome}</h3>
        <address>
          {clinica.rua}<br />
          {clinica.bairro}, {clinica.cidade} ({clinica.uf})<br />
          CEP {clinica.cep}
        </address>
        <div class="horarios">
          <Icone nome="relogio" tamanho={18} />
          {
            clinica.horarios ? (
              <ul>
                {clinica.horarios.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            ) : (
              <span>Atendimento com hora marcada</span>
            )
          }
        </div>
        <div class="acoes">
          <a class="botao linha" href={linkRotaGoogle} target="_blank" rel="noopener">
            <Icone nome="rota" tamanho={17} />
            Traçar rota no Google Maps
          </a>
          <a class="botao linha" href={linkRotaWaze} target="_blank" rel="noopener">Abrir no Waze</a>
        </div>
      </div>
      <div class="cartao redes">
        <h3>Acompanhe a clínica</h3>
        <p>Bastidores, novidades e respostas a dúvidas comuns.</p>
        <ul>
          {
            redes.map((r) => (
              <li>
                <a href={r.href} target="_blank" rel="noopener">
                  <span class="icone">
                    <Icone nome={r.icone} tamanho={20} />
                  </span>
                  <span class="rede">
                    <b>{r.nome}</b>
                    <small>{r.detalhe}</small>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .grade {
    margin-top: 56px;
    display: grid;
    gap: 20px;
  }
  @media (min-width: 880px) {
    .grade {
      grid-template-columns: 1.2fr 0.8fr;
      gap: 24px;
    }
  }
  .cartao {
    padding: clamp(26px, 3.4vw, 40px);
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    background: var(--papel);
    display: grid;
    gap: 18px;
    align-content: start;
    min-width: 0;
  }
  .icone {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid var(--linha);
    background: var(--branco);
    color: var(--bronze-texto);
    flex: none;
  }
  h3 {
    font-size: 21px;
  }
  address {
    font-style: normal;
    font-size: 18px;
    line-height: 1.6;
  }
  .horarios {
    display: flex;
    gap: 10px;
    align-items: baseline;
    color: var(--tinta-2);
  }
  .horarios :global(svg) {
    flex: none;
    color: var(--bronze-texto);
    translate: 0 3px;
  }
  .horarios ul {
    list-style: none;
    padding: 0;
  }
  .acoes {
    margin-top: 8px;
  }
  .redes p {
    color: var(--tinta-2);
    margin-top: -8px;
  }
  .redes ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .redes a {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px;
    margin-inline: -10px;
    border-radius: 12px;
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .redes a:hover {
    background: var(--branco);
  }
  .rede {
    display: grid;
    min-width: 0;
  }
  .rede b {
    font-weight: 650;
  }
  .rede small {
    font-size: 14.5px;
    color: var(--tinta-2);
    overflow-wrap: anywhere;
  }
</style>
