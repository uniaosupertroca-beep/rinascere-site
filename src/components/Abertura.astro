---
import { clinica, linkWhatsapp } from "../data/clinica.ts";
import Icone from "./Icone.astro";

const garantias = [
  { icone: "cadeado", texto: "Sigilo do primeiro contato ao retorno" },
  { icone: "escudo", texto: "Sem cirurgia e sem internação" },
  { icone: "avaliacao", texto: "Avaliação individual antes de tudo" },
] as const;
---

<section class="abertura" aria-labelledby="t-abertura">
  <div class="aurora" aria-hidden="true"></div>
  <div class="envolve conteudo">
    <p class="chapeu">Harmonização íntima masculina em {clinica.cidade}</p>
    <h1 id="t-abertura">
      <span class="linha"><span>Confiança se constrói</span></span>
      <span class="linha"><strong>com discrição.</strong></span>
    </h1>
    <p class="apoio">
      Preenchimento com ácido hialurônico, feito em consultório no centro de {clinica.cidade}. Uma avaliação reservada vem antes de qualquer
      aplicação, e tudo o que você conversa com a gente fica entre nós.
    </p>
    <div class="acoes">
      <a class="botao zap" href={linkWhatsapp()} target="_blank" rel="noopener">
        <Icone nome="whatsapp" tamanho={20} />
        Agendar avaliação
      </a>
      <a class="botao linha" href="#procedimento">Entender o procedimento</a>
    </div>
    <ul class="garantias">
      {
        garantias.map((g) => (
          <li>
            <Icone nome={g.icone} tamanho={19} />
            {g.texto}
          </li>
        ))
      }
    </ul>
  </div>
  <p class="envolve significado"><i lang="it">Rinascere</i>, do italiano: renascer.</p>
  <div class="assinatura" aria-hidden="true">
    <span class="palavra">Rinascere</span>
  </div>
</section>

<style>
  .abertura {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--grafite);
    color: var(--claro);
    padding-top: clamp(140px, 18vw, 200px);
  }
  .aurora {
    position: absolute;
    inset: -20% -10% 0;
    z-index: -1;
    background:
      radial-gradient(46% 52% at 78% 30%, color-mix(in oklab, var(--bronze) 30%, transparent), transparent 70%),
      radial-gradient(40% 46% at 12% 88%, color-mix(in oklab, var(--bronze) 16%, transparent), transparent 70%),
      radial-gradient(60% 60% at 50% 0%, var(--grafite-3), transparent 75%);
    filter: blur(8px);
  }
  .conteudo {
    position: relative;
  }
  .chapeu {
    color: var(--bronze);
  }
  h1 {
    margin-top: 26px;
    font-size: clamp(44px, 8.4vw, 104px);
    line-height: 1.02;
    font-weight: 200;
    letter-spacing: -0.025em;
  }
  h1 .linha {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  h1 .linha > * {
    display: inline-block;
  }
  h1 strong {
    font-weight: 650;
    color: var(--bronze);
  }
  .apoio {
    margin-top: 28px;
    max-width: 34em;
    font-size: clamp(17px, 1.6vw, 19.5px);
    color: var(--claro-2);
  }
  .acoes {
    margin-top: 36px;
  }
  .botao.linha {
    border-color: color-mix(in oklab, var(--claro) 28%, transparent);
    color: var(--claro);
  }
  .botao.linha:hover {
    border-color: var(--bronze);
  }
  .garantias {
    list-style: none;
    padding: 28px 0 0;
    margin-top: 40px;
    border-top: 1px solid color-mix(in oklab, var(--claro) 12%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    font-size: 15px;
    color: var(--claro-2);
  }
  .garantias li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .garantias :global(svg) {
    color: var(--bronze);
    flex: none;
  }

  /* A assinatura gigante, em traço de bronze, é a peça que marca a página. */
  .assinatura {
    margin-top: 10px;
    line-height: 0.74;
    text-align: center;
    pointer-events: none;
    user-select: none;
  }
  .palavra {
    display: inline-block;
    font-size: clamp(88px, 21.5vw, 330px);
    font-weight: 200;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--bronze) 55%, transparent);
    background: linear-gradient(180deg, color-mix(in oklab, var(--bronze) 20%, transparent), transparent 82%);
    -webkit-background-clip: text;
    background-clip: text;
  }
  .significado {
    margin-top: clamp(56px, 8vw, 96px);
    font-size: 13px;
    color: color-mix(in oklab, var(--claro) 58%, transparent);
    text-align: right;
  }

  @media (prefers-reduced-motion: no-preference) {
    h1 .linha > * {
      animation: sobe 1s cubic-bezier(0.2, 0.7, 0.1, 1) both;
    }
    h1 .linha:nth-child(2) > * {
      animation-delay: 0.12s;
    }
    .apoio,
    .acoes,
    .garantias {
      animation: surge 0.9s 0.35s cubic-bezier(0.2, 0.7, 0.1, 1) both;
    }
    .palavra {
      animation: acende 2.4s 0.4s ease-out both;
    }
    .aurora {
      animation: deriva 18s ease-in-out infinite alternate;
    }
  }
  @keyframes sobe {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes surge {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
  @keyframes acende {
    from {
      opacity: 0;
      translate: 0 6%;
    }
  }
  @keyframes deriva {
    to {
      transform: translate3d(4%, 3%, 0) scale(1.08);
    }
  }
</style>
