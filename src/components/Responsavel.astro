---
// Nome e registro no conselho de quem é responsável técnico: obrigatórios na publicidade do biomédico.
// Enquanto a clínica não informar, o site mostra o espaço marcado "a preencher".
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { clinica, rotulos } from "../data/clinica.ts";
import Monograma from "./Monograma.astro";

const r = clinica.responsavel;
const t = rotulos();
const fotos = import.meta.glob<{ default: ImageMetadata }>("../assets/fotos/*.{jpg,jpeg,png,webp}", { eager: true });
const foto = r.foto ? fotos[`../assets/fotos/${r.foto}`]?.default : undefined;
if (r.foto && !foto) throw new Error(`Foto não encontrada em src/assets/fotos/: ${r.foto}`);
// Sem foto, o retrato vira um cartão com as iniciais, no desenho da marca.
const iniciais = r.nome
  ?.split(/\s+/)
  .filter((p) => p.length > 2)
  .map((p) => p[0])
  .slice(0, 2)
  .join("");
---

<section class="secao linho" id="responsavel" aria-labelledby="t-responsavel">
  <div class="envolve grade">
    <figure class="retrato">
      {
        foto ? (
          <Image src={foto} alt={`${r.nome ?? "Profissional"}, ${t.cargo.toLowerCase()} da Rinascere`} widths={[440, 640]} sizes="(min-width: 900px) 440px, 100vw" loading="lazy" decoding="async" />
        ) : (
          <div class="sem-foto" aria-hidden="true">
            {iniciais ? <span class="iniciais">{iniciais}</span> : <Monograma tamanho={72} />}
            <span class="assina">{r.nome ?? "Rinascere"}</span>
          </div>
        )
      }
    </figure>
    <div class="texto">
      <p class="chapeu">{t.responsavel}</p>
      <h2 class="titulo" id="t-responsavel">
        {r.nome ? <strong>{r.nome}</strong> : <span class="preencher">{t.nomeVazio}</span>}
      </h2>
      <p class="registro">
        {t.cargo} · {r.registro ?? <span class="preencher">CRBM nº</span>}
      </p>
      <p class="sobre">
        {
          r.sobre ?? (
            <span class="preencher">Duas ou três frases sobre a formação, a experiência e o jeito de atender da profissional.</span>
          )
        }
      </p>
      <p class="nota">
        Os procedimentos são feitos com finalidade estética, por profissional {t.habilitado} em Biomedicina Estética, seguindo as normas do
        Conselho Federal de Biomedicina.
      </p>
    </div>
  </div>
</section>

<style>
  .grade {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .grade {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 88px;
    }
  }
  .retrato {
    position: relative;
    max-width: 440px;
    width: calc(100% - 14px);
  }
  .retrato::before {
    content: "";
    position: absolute;
    inset: 14px -14px -14px 14px;
    border: 1px solid var(--bronze);
    border-radius: var(--raio);
    z-index: 0;
  }
  .retrato :global(img),
  .sem-foto {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--raio);
  }
  .sem-foto {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 22px;
    background: radial-gradient(80% 70% at 50% 30%, var(--grafite-3), var(--grafite));
    color: var(--bronze);
    padding: 24px;
    text-align: center;
  }
  .iniciais {
    font-size: clamp(88px, 12vw, 140px);
    font-weight: 200;
    letter-spacing: 0.04em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--bronze);
  }
  .assina {
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--bronze-claro);
  }
  .registro {
    margin-top: 16px;
    font-size: 15px;
    font-weight: 650;
    letter-spacing: 0.06em;
    color: var(--bronze-texto);
  }
  .sobre {
    margin-top: 24px;
    max-width: 36em;
    font-size: 18.5px;
  }
  .nota {
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--linha);
    max-width: 38em;
    font-size: 14.5px;
    color: var(--tinta-2);
  }
</style>
