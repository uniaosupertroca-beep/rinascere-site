---
// Logo oficial da Rinascere (perfil + nome), em dourado sobre fundo transparente.
// Recortado do perfil do Instagram da clínica (src/assets/logo-rinascere.png).
import { Image } from "astro:assets";
import logo from "../assets/logo-rinascere.png";

interface Props {
  /** Altura do logo na tela, em pixels. */
  altura?: number;
}
const { altura = 40 } = Astro.props;
const largura = Math.round((logo.width / logo.height) * altura);
---

<Image src={logo} alt="Rinascere Aesthetics" width={largura} height={altura} densities={[1, 2, 3]} loading="eager" decoding="async" class="marca" />

<style>
  .marca {
    display: block;
    width: auto;
    max-width: 100%;
  }
</style>
