---
import { linkWhatsapp } from "../data/clinica.ts";
import Icone from "./Icone.astro";

interface Props {
  mensagem?: string;
}
const { mensagem } = Astro.props;
import Monograma from "./Monograma.astro";
---

<section class="chamada" aria-labelledby="t-chamada">
  <div class="envolve">
    <span class="selo"><Monograma tamanho={30} /></span>
    <h2 id="t-chamada">Dê o primeiro passo <strong>com discrição.</strong></h2>
    <p>A conversa começa no WhatsApp e fica entre você e a clínica. Sem compromisso: a avaliação existe para você decidir com calma.</p>
    <a class="botao zap" href={linkWhatsapp(mensagem)} target="_blank" rel="noopener">
      <Icone nome="whatsapp" tamanho={20} />
      Agendar avaliação
    </a>
  </div>
</section>

<style>
  .chamada {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--grafite);
    color: var(--claro);
    padding-block: clamp(96px, 12vw, 160px);
    text-align: center;
  }
  .chamada::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(50% 70% at 50% 100%, color-mix(in oklab, var(--bronze) 24%, transparent), transparent 70%);
  }
  .envolve {
    display: grid;
    justify-items: center;
  }
  .selo {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in oklab, var(--bronze) 50%, transparent);
    color: var(--bronze);
  }
  h2 {
    margin-top: 32px;
    font-size: clamp(36px, 6vw, 72px);
    line-height: 1.06;
    font-weight: 200;
    letter-spacing: -0.02em;
    max-width: 14em;
  }
  h2 strong {
    font-weight: 650;
    color: var(--bronze);
  }
  p {
    margin-top: 24px;
    max-width: 34em;
    font-size: 18px;
    color: var(--claro-2);
  }
  .botao {
    margin-top: 40px;
  }
</style>
